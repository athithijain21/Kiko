  "stories": [
    {
      "id": "thirsty-crow",
      "title": "ಬಾಯಾರಿದ ಕಾಗೆ",
      "e": "🏺",
      "from": "ಜಾನಪದ ಕಥೆ",
      "keywords": [
        "ಬಾಯಾರಿದ ಕಾಗೆ",
        "ಕಾಗೆ"
      ],
      "lines": [
        "ಅದು ತುಂಬಾ ಬಿಸಿಲಿನ ದಿನ.",
        "ಒಂದು ಕಾಗೆಗೆ ತುಂಬಾ ಬಾಯಾರಿಕೆ ಆಯಿತು.",
        "ಅದು ನೀರಿಗಾಗಿ ಎಲ್ಲೆಡೆ ಹುಡುಕಿತು.",
        "ಕೊನೆಗೆ ಅದಕ್ಕೆ ಒಂದು ಮಡಕೆ ಸಿಕ್ಕಿತು. ತಳದಲ್ಲಿ ಸ್ವಲ್ಪ ನೀರಿತ್ತು.",
        "ಕಾಗೆಯ ಕೊಕ್ಕು ನೀರಿಗೆ ತಲುಪಲಿಲ್ಲ!",
        "ಕಾಗೆಗೆ ಒಂದು ಉಪಾಯ ಹೊಳೆಯಿತು.",
        "ಅದು ಒಂದೊಂದಾಗಿ ಸಣ್ಣ ಕಲ್ಲುಗಳನ್ನು ಮಡಕೆಗೆ ಹಾಕಿತು.",
        "ಟಪ್, ಟಪ್, ಟಪ್! ನೀರು ಮೇಲೆ ಮೇಲೆ ಬಂತು.",
        "ಈಗ ಕಾಗೆ ನೀರು ಕುಡಿಯಿತು. ಆಹಾ!"
      ],
      "lesson": "ಯೋಚಿಸಿದರೆ ಸಮಸ್ಯೆಗೆ ಪರಿಹಾರ ಸಿಗುತ್ತದೆ."
    },
    {
